# =====================================================================
# LangGraph Multi-Agent System - Environment Variables Configuration
# =====================================================================
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit .env into source control (Git).

# --- Google Gemini Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# --- Optional Alternative: OpenAI ---
# OPENAI_API_KEY=your_openai_api_key_here
# DEFAULT_LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# --- RAG Ingestion & Retrieval Settings ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
MIN_SIMILARITY=0.3
MAX_UPLOAD_MB=20
TIMEZONE=Asia/Karachi

# --- Supabase Vector Database (PostgreSQL + pgvector) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_TABLE_NAME=documents

# --- GitHub MCP Sub-Agent ---
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token_here

# --- Google Calendar & Gmail OAuth 2.0 ---
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=token.json

# --- Email MCP Settings (SMTP/IMAP or Gmail API) ---
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_email_app_password_here
